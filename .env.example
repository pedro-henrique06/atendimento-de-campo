# URL da API. Em desenvolvimento deixe vazio: o proxy do Vite encaminha /api
# para http://localhost:5080. Em producao aponte para o servico da API, sem
# barra final. Ex.: https://minha-api.up.railway.app
VITE_API_URL=

# So para servir uma operacao de outra instituicao: as duas trocam a marca que
# vem empacotada em src/ativos/. Deixe vazias para usar a marca padrao.
#
# Preferir um arquivo colocado em `public/` (ex.: public/logo.png ->
# VITE_LOGO_URL=/logo.png): carrega junto do app e continua aparecendo quando a
# rede em campo cai. Uma URL completa tambem funciona, mas depende do servidor
# de origem estar no ar.
VITE_LOGO_URL=

# Nome da instituicao. Vira o texto alternativo da imagem, e o texto na tela
# quando a arte nao carrega.
VITE_INSTITUICAO=
