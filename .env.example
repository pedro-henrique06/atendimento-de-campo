# URL da API. Em desenvolvimento deixe vazio: o proxy do Vite encaminha /api
# para http://localhost:5080. Em producao aponte para o servico da API, sem
# barra final. Ex.: https://minha-api.up.railway.app
VITE_API_URL=

# Logotipo da instituicao que opera a base. Preferir um arquivo colocado em
# `public/` (ex.: public/logo.png -> VITE_LOGO_URL=/logo.png): carrega junto do
# app e continua aparecendo quando a rede em campo cai. Uma URL completa
# tambem funciona, mas depende do servidor de origem estar no ar.
# Vazio usa a marca propria do aplicativo.
VITE_LOGO_URL=

# Nome da instituicao, exibido ao lado do logotipo no login e no cabecalho.
VITE_INSTITUICAO=
